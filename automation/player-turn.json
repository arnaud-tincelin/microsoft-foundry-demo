{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "playerAgentVersion": {
        "type": "String"
      },
      "modelName": {
        "type": "String",
        "defaultValue": "gpt-4.1"
      }
    },
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["messages"],
            "properties": {
              "messages": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": ["outputs"]
          }
        }
      }
    },
    "actions": {
      "Foundry_agent": {
        "type": "Agent",
        "inputs": {
          "agentModelType": "FoundryAgentServiceV2",
          "modelConfigurations": {
            "model1": {
              "referenceName": "foundry-project"
            }
          },
          "parameters": {
            "foundryAgentId": "player",
            "foundryAgentName": "player",
            "foundryAgentVersion": "v2",
            "foundryVersionName": "@parameters('playerAgentVersion')",
            "deploymentId": "@parameters('modelName')",
            "messages": [
              {
                "role": "User",
                "content": "@triggerBody()['messages']"
              }
            ]
          },
          "retryPolicy": {
            "type": "none"
          }
        },
        "limit": {
          "count": 3,
          "timeout": "PT1M"
        },
        "operationOptions": "FailWhenLimitsReached",
        "runtimeConfiguration": {
          "secureData": {
            "properties": ["inputs", "outputs"]
          }
        },
        "runAfter": {}
      },
      "Parse_player_guess": {
        "type": "ParseJson",
        "inputs": {
          "content": "@outputs('Foundry_agent')['lastAssistantMessage']",
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["guess"],
            "properties": {
              "guess": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        },
        "runAfter": {
          "Foundry_agent": ["Succeeded"]
        }
      },
      "Return_agent_response": {
        "type": "Response",
        "inputs": {
          "statusCode": 200,
          "body": "@body('Parse_player_guess')"
        },
        "runAfter": {
          "Parse_player_guess": ["Succeeded"]
        }
      },
      "Respond_with_error": {
        "type": "Response",
        "inputs": {
          "statusCode": 502,
          "body": {
            "error": "The Foundry player failed or returned an invalid guess."
          }
        },
        "runAfter": {
          "Parse_player_guess": ["Failed", "Skipped", "TimedOut"]
        }
      },
      "Fail_run": {
        "type": "Terminate",
        "inputs": {
          "runStatus": "Failed",
          "runError": {
            "code": "InvalidPlayerTurn",
            "message": "The Foundry player failed or returned an invalid guess."
          }
        },
        "runAfter": {
          "Respond_with_error": ["Succeeded", "Failed", "TimedOut"]
        }
      }
    }
  },
  "kind": "Stateful"
}
