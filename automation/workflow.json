{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "foundryProjectEndpoint": {"type": "String"},
      "playerAgentVersion": {"type": "String"},
      "gameMasterAgentVersion": {"type": "String"},
      "gameTrackerApiUrl": {"type": "String"}
    },
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {"type": "object", "additionalProperties": false, "properties": {}}
        }
      }
    },
    "actions": {
      "Create_conversation": {
        "type": "Http",
        "inputs": {
          "uri": "@concat(parameters('foundryProjectEndpoint'), '/openai/v1/conversations')",
          "method": "POST",
          "headers": {"Content-Type": "application/json"},
          "authentication": {"type": "ManagedServiceIdentity", "audience": "https://ai.azure.com"},
          "retryPolicy": {"type": "none"},
          "body": {
            "items": [{
              "type": "message",
              "role": "user",
              "content": "Start a new guess-my-number game between player and gameMaster. The player moves first."
            }],
            "metadata": {
              "game_run_id": "@workflow()['run']['name']",
              "participants": "player,gameMaster",
              "trace_id": "@replace(guid(), '-', '')",
              "parent_span_id": "@substring(replace(guid(), '-', ''), 0, 16)"
            }
          }
        }
      },
      "Play_up_to_ten_turns": {
        "type": "Until",
        "runAfter": {"Create_conversation": ["Succeeded"]},
        "limit": {"count": 10, "timeout": "PT5M"},
        "expression": "@or(not(equals(body('Player')['status'], 'completed')), not(equals(body('Game_master')['status'], 'completed')), not(equals(json(last(last(body('Game_master')['output'])['content'])['text'])['status'], 'playing')))",
        "actions": {
          "Player": {
            "type": "Http",
            "inputs": {
              "uri": "@concat(parameters('foundryProjectEndpoint'), '/openai/v1/responses')",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json",
                "traceparent": "@concat('00-', body('Create_conversation')['metadata']['trace_id'], '-', body('Create_conversation')['metadata']['parent_span_id'], '-01')"
              },
              "authentication": {"type": "ManagedServiceIdentity", "audience": "https://ai.azure.com"},
              "retryPolicy": {"type": "none"},
              "body": {
                "conversation": "@body('Create_conversation')['id']",
                "metadata": {
                  "game_run_id": "@workflow()['run']['name']",
                  "turn": "@string(add(iterationIndexes('Play_up_to_ten_turns'), 1))"
                },
                "agent_reference": {
                  "type": "agent_reference",
                  "name": "player",
                  "version": "@parameters('playerAgentVersion')"
                },
                "input": "@concat('Player: make exactly one guess for turn ', string(add(iterationIndexes('Play_up_to_ten_turns'), 1)), ' of 10, using the game master feedback in this conversation.')"
              }
            },
            "runtimeConfiguration": {"secureData": {"properties": ["inputs", "outputs"]}}
          },
          "Game_master": {
            "type": "Http",
            "inputs": {
              "uri": "@concat(parameters('foundryProjectEndpoint'), '/openai/v1/responses')",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json",
                "traceparent": "@concat('00-', body('Create_conversation')['metadata']['trace_id'], '-', body('Create_conversation')['metadata']['parent_span_id'], '-01')"
              },
              "authentication": {"type": "ManagedServiceIdentity", "audience": "https://ai.azure.com"},
              "retryPolicy": {"type": "none"},
              "body": {
                "conversation": "@body('Create_conversation')['id']",
                "metadata": {
                  "game_run_id": "@workflow()['run']['name']",
                  "turn": "@string(add(iterationIndexes('Play_up_to_ten_turns'), 1))"
                },
                "agent_reference": {
                  "type": "agent_reference",
                  "name": "gameMaster",
                  "version": "@parameters('gameMasterAgentVersion')"
                },
                "input": "@concat('Game master: assess the latest player guess once and give your feedback. This is turn ', string(add(iterationIndexes('Play_up_to_ten_turns'), 1)), ' of 10.')"
              }
            },
            "runAfter": {"Player": ["Succeeded"]},
            "runtimeConfiguration": {"secureData": {"properties": ["inputs", "outputs"]}}
          }
        }
      },
      "Game_result": {
        "type": "ParseJson",
        "inputs": {
          "content": {
            "status": "@json(last(last(body('Game_master')['output'])['content'])['text'])['status']",
            "number_picked": "@json(last(last(body('Game_master')['output'])['content'])['text'])['number_picked']",
            "conversation_id": "@body('Create_conversation')['id']",
            "turns": "@int(body('Game_master')['metadata']['turn'])",
            "valid": "@and(equals(body('Player')['status'], 'completed'), equals(body('Game_master')['status'], 'completed'), equals(body('Player')['conversation']['id'], body('Create_conversation')['id']), equals(body('Game_master')['conversation']['id'], body('Create_conversation')['id']), equals(json(last(last(body('Game_master')['output'])['content'])['text'])['guess'], json(last(last(body('Player')['output'])['content'])['text'])['guess']), equals(json(last(last(body('Game_master')['output'])['content'])['text'])['hint'], if(equals(json(last(last(body('Player')['output'])['content'])['text'])['guess'], json(last(last(body('Game_master')['output'])['content'])['text'])['number_picked']), 'correct', if(less(json(last(last(body('Player')['output'])['content'])['text'])['guess'], json(last(last(body('Game_master')['output'])['content'])['text'])['number_picked']), 'higher', 'lower'))))"
          },
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "number_picked", "conversation_id", "turns", "valid"],
            "properties": {
              "status": {
                "type": "string",
                "enum": "@createArray(if(equals(json(last(last(body('Player')['output'])['content'])['text'])['guess'], json(last(last(body('Game_master')['output'])['content'])['text'])['number_picked']), 'won', 'lost'))"
              },
              "number_picked": {"type": "integer", "minimum": 1, "maximum": 100},
              "conversation_id": {"type": "string", "minLength": 1},
              "turns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "enum": "@if(equals(json(last(last(body('Game_master')['output'])['content'])['text'])['status'], 'lost'), createArray(10), range(1, 10))"
              },
              "valid": {"type": "boolean", "enum": [true]}
            }
          }
        },
        "runAfter": {"Play_up_to_ten_turns": ["Succeeded"]}
      },
      "Record_session": {
        "type": "Http",
        "inputs": {
          "uri": "@concat(parameters('gameTrackerApiUrl'), '/sessions')",
          "method": "POST",
          "headers": {"Content-Type": "application/json"},
          "body": {
            "conversation_id": "@body('Game_result')['conversation_id']",
            "number_picked": "@body('Game_result')['number_picked']",
            "status": "@body('Game_result')['status']"
          },
          "retryPolicy": {"type": "none"}
        },
        "runAfter": {"Game_result": ["Succeeded"]}
      },
      "Respond_with_result": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "body": {
            "status": "@body('Game_result')['status']",
            "number_picked": "@body('Game_result')['number_picked']",
            "conversation_id": "@body('Game_result')['conversation_id']",
            "turns": "@body('Game_result')['turns']",
            "message": {
              "status": "@body('Game_result')['status']",
              "number": "@if(equals(body('Game_result')['status'], 'won'), body('Game_result')['number_picked'], '-1')"
            },
            "session": "@body('Record_session')",
            "game_run_id": "@workflow()['run']['name']",
            "trace_id": "@body('Create_conversation')['metadata']['trace_id']",
            "agent_versions": {
              "player": "@parameters('playerAgentVersion')",
              "game_master": "@parameters('gameMasterAgentVersion')"
            }
          }
        },
        "runAfter": {"Record_session": ["Succeeded"]}
      },
      "Respond_with_error": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 502,
          "body": {
            "error": "Game execution or session recording failed. Review the Automation run history.",
            "game_run_id": "@workflow()['run']['name']"
          }
        },
        "runAfter": {"Record_session": ["Failed", "Skipped", "TimedOut"]}
      },
      "Fail_run": {
        "type": "Terminate",
        "inputs": {
          "runStatus": "Failed",
          "runError": {"code": "GameFailed", "message": "Game execution or session recording failed."}
        },
        "runAfter": {"Respond_with_error": ["Succeeded", "Failed", "TimedOut"]}
      }
    }
  },
  "kind": "Stateful"
}
