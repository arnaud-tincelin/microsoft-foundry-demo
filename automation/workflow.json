{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "gameTrackerApiUrl": {
        "type": "String"
      }
    },
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        }
      }
    },
    "actions": {
      "Initialize_number": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "number",
              "type": "Integer",
              "value": "@rand(1, 101)"
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_turn_count": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "turnCount",
              "type": "Integer",
              "value": 0
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_last_message": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "lastMessage",
              "type": "Object",
              "value": {
                "status": "playing"
              }
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_player_messages": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "playerMessages",
              "type": "Array",
              "value": [
                {
                  "role": "system",
                  "content": "You are the player in a guess-my-number game. The game master chose an integer between 1 and 100 inclusive. You have at most 10 guesses. Use the higher/lower feedback and previous guesses to narrow the range. Reply only with a JSON object containing an integer guess, for example {\"guess\": 50}. Never switch roles."
                },
                {
                  "role": "user",
                  "content": "The game has started. Make your first guess."
                }
              ]
            }
          ]
        },
        "runAfter": {}
      },
      "Initialize_failure_flag": {
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "gameFailed",
              "type": "Boolean",
              "value": false
            }
          ]
        },
        "runAfter": {}
      },
      "Play_up_to_ten_turns": {
        "type": "Until",
        "expression": "@or(variables('gameFailed'), not(equals(variables('lastMessage')['status'], 'playing')))",
        "limit": {
          "count": 10,
          "timeout": "PT5M"
        },
        "operationOptions": "FailWhenLimitsReached",
        "runAfter": {
          "Initialize_number": [
            "Succeeded"
          ],
          "Initialize_turn_count": [
            "Succeeded"
          ],
          "Initialize_last_message": [
            "Succeeded"
          ],
          "Initialize_player_messages": [
            "Succeeded"
          ],
          "Initialize_failure_flag": [
            "Succeeded"
          ]
        },
        "actions": {
          "Player": {
            "type": "Workflow",
            "inputs": {
              "host": {
                "workflow": {
                  "id": "player-turn"
                },
                "triggerName": "When_an_HTTP_request_is_received"
              },
              "body": {
                "messages": "@string(variables('playerMessages'))"
              },
              "retryPolicy": {
                "type": "none"
              }
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": ["inputs", "outputs"]
              }
            },
            "runAfter": {}
          },
          "Game_master": {
            "type": "Workflow",
            "inputs": {
              "host": {
                "workflow": {
                  "id": "game-master-turn"
                },
                "triggerName": "When_an_HTTP_request_is_received"
              },
              "body": {
                "number": "@variables('number')",
                "guess": "@body('Player')['guess']"
              },
              "retryPolicy": {
                "type": "none"
              }
            },
            "runtimeConfiguration": {
              "secureData": {
                "properties": ["inputs", "outputs"]
              }
            },
            "runAfter": {
              "Player": ["Succeeded"]
            }
          },
          "Count_turn": {
            "type": "IncrementVariable",
            "inputs": {
              "name": "turnCount",
              "value": 1
            },
            "runAfter": {
              "Game_master": ["Succeeded"]
            }
          },
          "Check_win_or_turn_limit": {
            "type": "If",
            "expression": "@equals(body('Game_master')['status'], 'won')",
            "runAfter": {
              "Count_turn": ["Succeeded"]
            },
            "actions": {
              "Game_won_message": {
                "type": "SetVariable",
                "inputs": {
                  "name": "lastMessage",
                  "value": {
                    "status": "won",
                    "number": "@body('Game_master')['number']"
                  }
                },
                "runAfter": {}
              }
            },
            "else": {
              "actions": {
                "Check_turn_limit": {
                  "type": "If",
                  "expression": "@greaterOrEquals(variables('turnCount'), 10)",
                  "runAfter": {},
                  "actions": {
                    "Game_lost_message": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "lastMessage",
                        "value": {
                          "status": "lost",
                          "number": "-1"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Remember_guess": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "playerMessages",
                          "value": {
                            "role": "assistant",
                            "content": "@string(body('Player'))"
                          }
                        },
                        "runAfter": {}
                      },
                      "Remember_hint": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "playerMessages",
                          "value": {
                            "role": "user",
                            "content": "@body('Game_master')['hint']"
                          }
                        },
                        "runAfter": {
                          "Remember_guess": ["Succeeded"]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "Mark_failed_turn": {
            "type": "SetVariable",
            "inputs": {
              "name": "gameFailed",
              "value": true
            },
            "runAfter": {
              "Check_win_or_turn_limit": ["Failed", "Skipped", "TimedOut"]
            }
          }
        }
      },
      "Finalize_game": {
        "type": "Scope",
        "runAfter": {
          "Play_up_to_ten_turns": ["Succeeded"]
        },
        "actions": {
          "Validate_game_completion": {
            "type": "ParseJson",
            "inputs": {
              "content": {
                "failed": "@variables('gameFailed')",
                "turns": "@variables('turnCount')",
                "status": "@variables('lastMessage')['status']"
              },
              "schema": {
                "type": "object",
                "required": [
                  "failed",
                  "turns",
                  "status"
                ],
                "properties": {
                  "failed": {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": ["won", "lost"]
                  },
                  "turns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                }
              }
            },
            "runAfter": {}
          },
          "Game_result": {
            "type": "Compose",
            "inputs": {
              "conversation_id": "@workflow()['run']['name']",
              "number_picked": "@variables('number')",
              "status": "@variables('lastMessage')['status']"
            },
            "runAfter": {
              "Validate_game_completion": [
                "Succeeded"
              ]
            }
          },
          "Record_session": {
            "type": "Http",
            "inputs": {
              "uri": "@concat(parameters('gameTrackerApiUrl'), '/sessions')",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": "@outputs('Game_result')",
              "retryPolicy": {
                "type": "none"
              }
            },
            "runAfter": {
              "Game_result": [
                "Succeeded"
              ]
            }
          }
        }
      },
      "Respond_with_result": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "body": {
            "conversation_id": "@outputs('Game_result')['conversation_id']",
            "number_picked": "@outputs('Game_result')['number_picked']",
            "status": "@outputs('Game_result')['status']",
            "turns": "@variables('turnCount')",
            "message": "@variables('lastMessage')",
            "session": "@body('Record_session')"
          }
        },
        "runAfter": {
          "Finalize_game": [
            "Succeeded"
          ]
        }
      },
      "End_conversation": {
        "type": "Terminate",
        "inputs": {
          "runStatus": "Succeeded"
        },
        "runAfter": {
          "Respond_with_result": ["Succeeded"]
        }
      },
      "Respond_with_error": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 502,
          "body": {
            "error": "Game execution or session recording failed. Review the Automation run history.",
            "conversation_id": "@workflow()['run']['name']"
          }
        },
        "runAfter": {
          "Finalize_game": [
            "Failed",
            "Skipped",
            "TimedOut"
          ]
        }
      },
      "Fail_run": {
        "type": "Terminate",
        "inputs": {
          "runStatus": "Failed",
          "runError": {
            "code": "GameFailed",
            "message": "Game execution or session recording failed."
          }
        },
        "runAfter": {
          "Respond_with_error": [
            "Succeeded",
            "Failed",
            "TimedOut"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
